# Agent Board web application
HOST=127.0.0.1
PORT=8080
AGENT_BOARD_DB=./db/agent-board.sqlite
AUTH_COOKIE_NAME=agent_board_session
# NODE_ENV=production

# Board Agent chat (OpenAI Responses API or compatible provider)
CHAT_LLM_MODEL=gpt-5.1
CHAT_LLM_API_KEY=
CHAT_LLM_BASE_URL=https://api.openai.com/v1
CHAT_MAX_TOOL_TURNS=12

# Optional complete override for the built-in Board Agent system prompt.
# Keep this on one line. When omitted, the board-specific prompt in
# lib/chat/config.js is used.
# CHAT_SYSTEM_PROMPT=You are Board Agent...

# Streamable HTTP MCP server (npm run mcp:http)
AGENT_BOARD_HOST=127.0.0.1
AGENT_BOARD_PORT=3000
AGENT_BOARD_PATH=/mcp
AGENT_BOARD_TOKEN=
# Comma-separated browser origins allowed to call the MCP endpoint.
AGENT_BOARD_ALLOWED_ORIGINS=
